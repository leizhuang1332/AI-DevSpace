{
  "name": "@ai-devspace/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3333",
    "build": "cross-env AIDEVSPACE_CONFIG_PATH=$INIT_CWD/.aidevspace/config.yaml next build",
    "start": "next start -p 3333",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@ai-devspace/shared": "workspace:*",
    "@tanstack/react-query": "^5.59.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^14.2.0",
    "next-themes": "^0.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "yaml": "^2.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.5.2",
    "cross-env": "^10.1.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4",
    "tailwindcss-animate": "^1.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  }
}